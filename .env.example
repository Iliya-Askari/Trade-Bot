# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Database Settings
# For local dev/test we use SQLite
DATABASE_URL=sqlite:///./trading.db

# API Keys (Placeholders)
MARKET_DATA_API_KEY=your_market_data_key_here
NEWS_API_KEY=your_news_key_here
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here

# MT5 Configuration
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server
DEFAULT_SYMBOL=XAUUSD

# Trading Configuration
TRADING_MODE=PAPER_TRADING
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.10
MAX_LEVERAGE=1.0

# AI Configuration
AI_MODEL_PROVIDER=local
AI_MODEL_NAME=mistral-7b
AI_TEMPERATURE=0.7
